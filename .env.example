# Modelo dos segredos locais. Copie para .dev.vars (NÃO para .env.local) e preencha:
# o OpenNext embute os arquivos .env* no Worker publicado, e o .dev.vars fica de fora.
# Em produção (Cloudflare), os valores vêm de `wrangler secret put` e do binding HYPERDRIVE.

# Banco: pooler do Supabase em modo transação (porta 6543), com o usuário de banco do app.
# Formato: postgresql://greencrm_app.<project-ref>:<senha>@<host-do-pooler>:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase Auth (login do CRM): Project Settings → API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Só para `npm run preview` (Workers local): emula o Hyperdrive com o pooler em modo sessão (porta 5432).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
